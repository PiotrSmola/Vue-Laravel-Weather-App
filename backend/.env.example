APP_NAME="Poland&World Weather"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
OPENWEATHER_API_KEY=
# Limit czasu zapytań do OpenWeatherMap (s) i limit ulubionych miast
WEATHER_TIMEOUT=10
WEATHER_FAVORITES_LIMIT=10
# One Call API 3.0 (UV, oficjalne ostrzeżenia, prognoza 8-dniowa) - wymaga osobnej subskrypcji
# "One Call by Call" w OpenWeatherMap. Bez subskrypcji zostaw false.
WEATHER_ONECALL_ENABLED=false
# Limit zapytań wychodzących do OpenWeatherMap na minutę (darmowy plan: 60/min, nadmiar = HTTP 429).
# Po wyczerpaniu API zwraca 503 bez odpytywania OpenWeatherMap. 0 = bez limitu.
WEATHER_RATE_LIMIT_PER_MINUTE=45
# Osobny limit pobrań kafelków mapy z OpenWeatherMap na minutę; po wyczerpaniu - przezroczysty kafelek
WEATHER_TILE_RATE_LIMIT_PER_MINUTE=15
# Przerwa między zapytaniami komend weather:update, air:update i alerts:forecast (ms) - utrzymuje je poniżej limitu
WEATHER_UPDATE_DELAY_MS=1500
# Mapa: czas cache kafelków (min), magazyn cache kafelków, limit kafelków na minutę na IP (przeglądarka)
WEATHER_TILE_CACHE_MINUTES=60
WEATHER_TILE_CACHE_STORE=file
WEATHER_TILE_RATE_LIMIT=300
# Adresy frontendu dla CORS (oddzielone przecinkami)
FRONTEND_URL=http://localhost:5173,http://localhost:5174
# Ważność tokenów logowania w minutach (domyślnie 30 dni)
SANCTUM_EXPIRATION=43200

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=weather_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Alerty pogodowe: limit reguł na użytkownika, domyślny odstęp powiadomień (min)
ALERTS_RULES_LIMIT=20
ALERTS_DEFAULT_COOLDOWN=360

# Web Push (klucze VAPID) - generowane przez: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
