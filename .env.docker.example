# Zmienne dla docker compose. setup.sh / setup.ps1 kopiuje ten plik do .env
# Porty na hoście
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_HOST_PORT=3307

# Baza danych MySQL w kontenerze
DB_DATABASE=weather_app
DB_USERNAME=weather
DB_PASSWORD=weather
DB_ROOT_PASSWORD=root

# Właściciel plików tworzonych przez kontener (Linux: wynik `id -u` / `id -g`)
UID=1000
GID=1000
